1.Path Sum (LEETCODE 112)(EASY)
   CONCEPT : Recursion

class Solution {
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if (root == null) return false;
        if (root.left == null && root.right == null) return targetSum == root.val;
        boolean leftSum = hasPathSum(root.left, targetSum - root.val);
        boolean rightSum = hasPathSum(root.right, targetSum - root.val);
        return leftSum || rightSum;
    }
}

2. Diameter OF BINARY TREE (LEETCODE 543)(EASY)
   CONCEPT : Tree

class Solution {
    int ans = 0;
    public int height(TreeNode root) {
        if (root == null) return 0;
        int l = height(root.left);
        int r = height(root.right);
        ans = Math.max(ans, l + r);
        return 1 + Math.max(l, r);
    }
    public int diameterOfBinaryTree(TreeNode root) {
        height(root);
        return ans;
    }
}

3. Binary Tree Maximum Path Sum (LEETCODE 124)(HARD)
   CONCEPT :Recursion

class Solution {
    private int max = Integer.MIN_VALUE;
    public int maxPathSum(TreeNode root) {
        pathmax(root);
        return max;
    }
    private int pathmax(TreeNode node) {
        if (node == null) return 0;
        int l = Math.max(pathmax(node.left), 0);
        int r = Math.max(pathmax(node.right), 0);
        int newprice = node.val + l + r;
        max = Math.max(max, newprice);
        return node.val + Math.max(l, r);
    }
}
